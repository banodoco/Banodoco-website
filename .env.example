# Copy to .env. Values are placeholders; never commit populated credentials.
PORT=8137
APP_ORIGIN=http://127.0.0.1:8137
# Use the SAME Supabase project/custom auth domain as the Hivemind broker.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SESSION_TTL_SECONDS=3600
# Discord client ID/secret are configured in Supabase Auth > Providers > Discord.
# They are not needed in this website's environment or browser code.
