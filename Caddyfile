:{$PORT} {
    root * /app/dist
    encode gzip
    @social2rp {
        path /2rp /2rp/ /2RP /2RP/
        expression `{header.User-Agent}.matches("(?i).*?(?:Twitterbot|facebookexternalhit|Discordbot|Slackbot|LinkedInBot|TelegramBot|WhatsApp|Embedly|SkypeUriPreview|bingbot|googlebot|applebot).*")`
    }
    @resourceOg {
        path_regexp resourceOg ^/(?:[^/]+/)?resources/([^/?#]+)$
        expression `{header.User-Agent}.matches("(?i).*?(?:Twitterbot|facebookexternalhit|Discordbot|Slackbot|LinkedInBot|TelegramBot|WhatsApp|Embedly|SkypeUriPreview|bingbot|googlebot|applebot).*")`
    }
    rewrite @social2rp /2rp-social.html
    redir @resourceOg https://ujlwuvkrxlvoswwkerdf.supabase.co/functions/v1/resource-og?slug={re.resourceOg.1} 302
    try_files {path} /index.html
    file_server
}
