:{$PORT} {
    root * /app/dist
    encode gzip
    @social2rp {
        path /2rp /2rp/ /2RP /2RP/
        header_regexp User-Agent (?i)(Twitterbot|facebookexternalhit|Discordbot|Slackbot|LinkedInBot|TelegramBot|WhatsApp|Embedly|SkypeUriPreview|bingbot|googlebot|applebot)
    }
    rewrite @social2rp /2rp-social.html
    try_files {path} /index.html
    file_server
}
