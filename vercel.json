{
  "rewrites": [
    {
      "source": "/2rp",
      "destination": "/2rp-social.html"
    },
    {
      "source": "/2rp/",
      "destination": "/2rp-social.html"
    },
    {
      "source": "/resources/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(Twitterbot|facebookexternalhit|Discordbot|Slackbot|LinkedInBot|TelegramBot|WhatsApp|Embedly|SkypeUriPreview|bingbot|googlebot|applebot)"
        }
      ],
      "destination": "https://ujlwuvkrxlvoswwkerdf.supabase.co/functions/v1/resource-og?slug=:slug"
    },
    {
      "source": "/:username/resources/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(Twitterbot|facebookexternalhit|Discordbot|Slackbot|LinkedInBot|TelegramBot|WhatsApp|Embedly|SkypeUriPreview|bingbot|googlebot|applebot)"
        }
      ],
      "destination": "https://ujlwuvkrxlvoswwkerdf.supabase.co/functions/v1/resource-og?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
