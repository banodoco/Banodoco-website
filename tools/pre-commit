#!/bin/bash
# Regression gate for scene-touching commits (merge doc §4 M6).
# Install:  ln -sf "$(pwd)/tools/pre-commit" .git/hooks/pre-commit
# (run from the repo root — tools/ sits at the site root, not in a
#  nested glowshroom/ subdir; the original hook hard-coded an
#  ados-paris/glowshroom layout and was repaired to be portable.)
#
# Scene-touching = anything staged under organism/ or journey/. For those
# commits the site must be up on :8137 and capture.py --check (the FROZEN,
# non-advisory gate — see tools/capture.py's header comment) must pass:
# every golden/size pair within FAIL_MAE_FROZEN of the on-disk goldens at
# static/captures/ (threshold + how it was measured: journey-v6-plan/
# EXECUTION.md's M6 entry). Scene commits carry a second gate, also
# non-advisory: bake-geom.py --check re-derives the chapter .bins in the
# same headless Chrome and byte-diffs them against static/geom/ — a seed
# change that didn't regenerate the bake fails the commit. Skip with
# SKIP_SCENE_CHECK=1 for doc-only emergencies — never for code.
#
# Capture-gate decision policy: identical to tools/check.sh's (Q05/D13/D15;
# see that file's decide_captures() for the full contract and rationale).
# There is no longer a named-pose exemption — final@430x932's ~24 MAE flake
# (chrome bakes into the mobile final golden; the chrome-hide selectors
# match nothing at that pose — same nondeterminism class as mission@430x932,
# BUILDING.md) is a hard non-pass like any other [FAIL-band] row. The one
# sanctioned way past a genuine environment issue is the shared adjudication
# escape hatch: CAPTURE_CHECK_ADJUDICATION=<reason> turns a fail-band result
# into a distinct, still-non-zero `blocked` status (exit 3) — never a pass.
# This hook sources check.sh's decide_captures() rather than reimplementing
# it, so the two gates cannot drift apart again.

# Resolve the hook's real location via the repo root, not $0/BASH_SOURCE:
# this file is installed as a SYMLINK at .git/hooks/pre-commit, and when git
# execs a symlinked hook, $0 is the symlink path (.git/hooks/pre-commit) —
# dirname "$0" would look for capture.py inside .git/hooks/ and fail. git
# always runs hooks with cwd at the top of the working tree, so anchor off
# `git rev-parse --show-toplevel` instead, which is symlink-proof.
REPO_ROOT="$(git rev-parse --show-toplevel)"
TOOLS="$REPO_ROOT/tools"
CAPTURE_PY="$TOOLS/capture.py"
BAKE_PY="$TOOLS/bake-geom.py"
META_PY="$TOOLS/build-meta.py"
STATIC_CONTENT="$TOOLS/build-static-content.mjs"

STAGED=$(git diff --cached --name-only)

# The static tier is generated HTML, not a hand-maintained twin. Block any
# content/tool/static commit whose checked-in output is not the deterministic
# derivation of content/content.js. --check never writes.
if echo "$STAGED" | grep -q "content/content.js\|static/index.html\|tools/build-static-content.mjs"; then
  STAGED_TREE=$(mktemp -d /tmp/banodoco-staged-content.XXXXXX) || exit 2
  trap 'rm -rf "$STAGED_TREE"' EXIT
  git checkout-index --all --prefix="$STAGED_TREE/" || exit 1
  node "$STAGED_TREE/tools/build-static-content.mjs" --check || {
    echo "pre-commit: static content is stale." >&2
    echo "  Regenerate: node tools/build-static-content.mjs, then stage static/index.html" >&2
    exit 1
  }
fi

# Derived identity assets: favicons are cut from the favicon master, and og
# cards from the mark master plus mission/owned captures, by build-meta.py
# (same regenerate-never-repaint contract as the geometry bake). A re-blessed
# capture that doesn't re-run it silently ships a stale social card, so when a
# source or the script is staged, byte-check the derivation. Pure PIL — no
# server.
if echo "$STAGED" | grep -q \
  "static/captures/mission@1440x900.png\|static/captures/owned@1440x900.png\|assets/brand/mark-b-source.png\|assets/brand/favicon-source.png\|tools/build-meta.py"; then
  python3 "$META_PY" --check || {
    echo "pre-commit: derived favicons/og cards are stale vs their sources." >&2
    echo "  Rebuild:  python3 tools/build-meta.py, then git add favicon.ico assets/brand" >&2
    exit 1
  }
fi

# --- BEGIN DWELL RECEIPT GATE (§5.4 of the scroll-through-category design) ---
#
# THE CATEGORY THIS CLOSES IS A WIRING FAILURE. Four owner reports of "it
# scrolled through the section", months apart, each diagnosed and each fixed
# — and the only instrument that can observe the class, tools/dwell-run.mjs,
# was wired into no required ring and had never run. Its contract was also
# stale, but that cost nothing on its own: a stale contract and a contract
# nobody evaluates are the same object.
#
# So the browser ring is REQUIRED FOR THE PATHS THAT OWN THE CLASS. It is
# deliberately NOT inside `npm run check` — it needs Chrome and a served
# tree, and a check people cannot run at their desk gets bypassed within a
# week, which is exactly how this category got here.
#
# The receipt stamps the SHA of each governed file as the green run measured
# it, so this gate asks "was the ring green against THESE bytes", not "was a
# browser run ever done" — which is all a timestamp could say. The governed
# list lives in tools/dwell-oracle.mjs (GOVERNED_PATHS) and is read from
# there, never copied here: two copies of a path list is how a file quietly
# stops being governed.
#
# The override is DELIBERATELY NOISY and DELIBERATELY RECORDED. §9 of the
# design says this gate is load-bearing and that habitual overriding reverts
# the whole design to the status quo, so the escape hatch demands a reason
# and prints it, in the shape CAPTURE_CHECK_ADJUDICATION already uses.
DWELL_RECEIPT="$TOOLS/dwell-receipt.json"
DWELL_GOVERNED=$(node -e '
  import("'"$TOOLS"'/dwell-oracle.mjs").then((m) => console.log(m.GOVERNED_PATHS.join("\n")));
' 2>/dev/null)
if [ -z "$DWELL_GOVERNED" ]; then
  echo "pre-commit: could not read GOVERNED_PATHS from tools/dwell-oracle.mjs." >&2
  exit 1
fi
DWELL_HIT=""
while IFS= read -r gp; do
  [ -z "$gp" ] && continue
  if echo "$STAGED" | grep -qx "$gp"; then DWELL_HIT="$DWELL_HIT $gp"; fi
done <<< "$DWELL_GOVERNED"

if [ -n "$DWELL_HIT" ]; then
  if [ -n "${DWELL_RING_ADJUDICATION:-}" ]; then
    echo "pre-commit: DWELL RING OVERRIDDEN for$DWELL_HIT" >&2
    echo "  reason: $DWELL_RING_ADJUDICATION" >&2
    echo "  (§9: this gate is load-bearing. Habitual overriding reverts the design to the status quo.)" >&2
  elif [ ! -f "$DWELL_RECEIPT" ]; then
    echo "pre-commit: staged$DWELL_HIT but there is no browser-ring receipt." >&2
    echo "  These files own the in-flight authority class (four owner reports)." >&2
    echo "  Run:  PORT=8177 python3 serve.py   then   npm run test:dwell" >&2
    echo "  Override (recorded):  DWELL_RING_ADJUDICATION='<reason>' git commit ..." >&2
    exit 1
  else
    # Compare the receipt's stamped hashes against the STAGED bytes, not the
    # working tree's: the commit is what ships, and an unstaged edit that
    # happened to match the receipt would otherwise let a different tree
    # inherit the pass. The staged blobs are read one at a time with
    # `git show :<path>` rather than by materialising the whole index — the
    # static-content gate above checks out the full tree because it runs a
    # BUILD over it, and this gate needs five files.
    DWELL_STALE=$(node -e '
      const { readFileSync } = require("node:fs");
      const { execFileSync } = require("node:child_process");
      const { createHash } = require("node:crypto");
      const receipt = JSON.parse(readFileSync(process.argv[1], "utf8"));
      const stale = [];
      for (const [rel, want] of Object.entries(receipt.governed || {})) {
        let got = "NOT-IN-INDEX";
        try {
          const blob = execFileSync("git", ["show", `:${rel}`], { maxBuffer: 1 << 26 });
          got = createHash("sha256").update(blob).digest("hex").slice(0, 16);
        } catch { /* deleted, or never tracked */ }
        if (got !== want) stale.push(`${rel} (receipt ${want}, staged ${got})`);
      }
      if (stale.length) console.log(stale.join("\n"));
    ' "$DWELL_RECEIPT" 2>&1)
    if [ -n "$DWELL_STALE" ]; then
      echo "pre-commit: the browser-ring receipt does not cover this staged tree." >&2
      echo "$DWELL_STALE" | sed 's/^/    /' >&2
      echo "  Run:  PORT=8177 python3 serve.py   then   npm run test:dwell" >&2
      echo "  Override (recorded):  DWELL_RING_ADJUDICATION='<reason>' git commit ..." >&2
      exit 1
    fi
    echo "pre-commit: browser-ring receipt covers$DWELL_HIT" >&2
  fi
fi
# --- END DWELL RECEIPT GATE ---

echo "$STAGED" | grep -q "organism/\|journey/" || exit 0

if [ -n "$SKIP_SCENE_CHECK" ]; then
  echo "pre-commit: SKIP_SCENE_CHECK set — scene regression skipped" >&2
  exit 0
fi

# tools/release.sh runs tools/check.sh immediately before committing; when it
# sets PREFLIGHT_DONE the gates have just passed on this exact staged tree, so
# re-running them here would duplicate ~4 min of headless Chrome for zero
# signal. Ad-hoc commits (outside the release flow) still get the full gate.
if [ -n "${PREFLIGHT_DONE:-}" ]; then
  echo "pre-commit: gates already run by tools/release.sh (PREFLIGHT_DONE) — skipping duplicate run" >&2
  exit 0
fi

if [ ! -f "$CAPTURE_PY" ]; then
  echo "pre-commit: expected capture.py at $CAPTURE_PY — not found." >&2
  exit 1
fi

if [ ! -f "$BAKE_PY" ]; then
  echo "pre-commit: expected bake-geom.py at $BAKE_PY — not found." >&2
  exit 1
fi

if ! curl -s -o /dev/null --max-time 2 http://localhost:8137/; then
  echo "pre-commit: scene files staged but no server on :8137." >&2
  echo "  Start it:  python3 $TOOLS/../serve.py" >&2
  echo "  (or SKIP_SCENE_CHECK=1 to bypass — code commits should not.)" >&2
  exit 1
fi

# --- BEGIN CAPTURE GATE (sourced verbatim by tools/test_capture_check.py's
# --- precommit-wiring test between these two markers — keep it a
# --- self-contained shell fragment; do not rely on state defined outside
# --- this block other than TOOLS and CAPTURE_PY) ---
#
# capture gate — decided by tools/check.sh's decide_captures(), sourced
# (not duplicated) so this hook can never re-diverge from the accepted
# decision table. Run in an isolated `bash -c` subshell, exactly as
# tools/test_capture_check.py drives it: check.sh's `set -euo pipefail`
# then applies only inside that subshell, never leaking into this hook's
# own (non -e) error handling. The BASH_SOURCE[0]==$0 guard at the bottom
# of check.sh skips its `main` (Chrome/curl/rebuild) when sourced.
CAPTURE_LOG=$(mktemp)
python3 "$CAPTURE_PY" --check > "$CAPTURE_LOG" 2>&1
CAPTURE_RC=$?
CHECK_SH="$TOOLS/check.sh"
if [ ! -f "$CHECK_SH" ]; then
  echo "pre-commit: expected check.sh at $CHECK_SH — not found." >&2
  rm -f "$CAPTURE_LOG"
  exit 1
fi
bash -c 'source "$1"; decide_captures "$2" "$3"' _ "$CHECK_SH" "$CAPTURE_LOG" "$CAPTURE_RC"
DECIDE_RC=$?
rm -f "$CAPTURE_LOG"
if [ $DECIDE_RC -ne 0 ]; then
  echo "pre-commit: capture check did not pass (exit $DECIDE_RC; see output above)." >&2
  exit $DECIDE_RC
fi
# --- END CAPTURE GATE ---

python3 "$BAKE_PY" --check || {
  echo "pre-commit: geometry bake is stale — see output above." >&2
  echo "  Re-bake it:  python3 tools/bake-geom.py, then git add static/geom" >&2
  exit 1
}
