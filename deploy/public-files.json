{
  "files": [
    "404.html",
    "favicon.ico",
    "flags.js",
    "hero.css",
    "hero-deco.js",
    "hero-deco.css",
    "mycelial.css",
    "manifesto-note.js",
    "manifesto-link-tooltip.js",
    "assets/fonts/mycelial/Cormorant-Garamond-OFL.txt",
    "assets/fonts/mycelial/DM-Sans-OFL.txt",
    "index.html",
    "inspire-exits.js",
    "main.js",
    "runtime-release.js",
    "runtime-source.js",
    "robots.txt",
    "serve.py",
    "site.webmanifest",
    "sitemap.xml"
  ],
  "trees": [
    {
      "path": "runtime",
      "include": ["*.js", "*.json", "*.bin", "*.jpg"]
    },
    {
      "path": "assets",
      "include": ["*.js", "*.json", "*.jpg", "*.mp4", "*.png", "*.svg", "*.woff2", "*.ttf"],
      "exclude": [
        "brand/favicon-source.png",
        "brand/favicon-source-small.png",
        "brand/favicon-small.svg",
        "brand/mark-b-source.png"
      ]
    },
    {
      "path": "content",
      "include": ["connect-nodes.js", "content.js", "contributors.js", "manifesto-concepts.js", "manifesto-links.js"]
    },
    {
      "path": "journey",
      "include": ["*.css", "*.html", "*.js"]
    },
    {
      "path": "journey-v6",
      "include": ["index.html"]
    },
    {
      "path": "organism",
      "include": ["*.js"]
    },
    {
      "path": "ownership",
      "include": ["*.css", "*.html", "*.js"]
    },
    {
      "path": "static",
      "include": ["*.bin", "*.html", "*.json", "*.png"],
      "exclude": ["captures/_check/**", "captures/manifest.json"]
    },
    {
      "path": "vendor/three",
      "include": ["*.js"]
    }
  ],
  "required": [
    "index.html",
    "inspire-exits.js",
    "404.html",
    "main.js",
    "release-revision.txt",
    "serve.py",
    "static/index.html",
    "ownership/index.html",
    "content/connect-nodes.js",
    "journey/index.html",
    "journey-v6/index.html",
    "static/geom/manifest.json",
    "static/captures/mission@1440x900.png",
    "assets/cards/discord/fallback.json",
    "assets/contributor-portraits/manifest.js",
    "assets/contributor-portraits/profile-sprite.jpg",
    "vendor/three/three.module.js",
    "vendor/three/addons/controls/OrbitControls.js",
    "vendor/three/addons/postprocessing/EffectComposer.js"
  ],
  "forbidden": [
    ".desloppify",
    ".git",
    "__pycache__",
    "archive",
    "deploy",
    "docs",
    "journey-v6-plan",
    "node_modules",
    "tools"
  ]
}
